    function toggleSub(el) {
        const sub = el.nextElementSibling;
        const icon = el.querySelector(".material-icons");
        const isOpen = sub.style.display === "block";
        sub.style.display = isOpen ? "none" : "block";
        if (icon) icon.style.transform = isOpen ? "rotate(0)" : "rotate(180deg)";
        event.stopPropagation();
    }

    // Keresés overlay toggle
    function toggleVepSearch(open) {
        const overlay = document.getElementById("vepSearchOverlay");
        if (open) {
            overlay.classList.add("active"); 
            document.body.classList.add("vep-search-open");
            setTimeout(() => { 
                overlay.querySelector('.vep-search-input').focus(); 
            }, 100);
        } else {
            overlay.classList.remove("active"); 
            document.body.classList.remove("vep-search-open");
        }
    }

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        toggleVepMenu(false);
    }
});
    
    // Slider inicializálás
    (function() {
        function initSlides() {
            let slides = document.querySelectorAll('.vep-slide');
            let isMobile = window.innerWidth < 768;
            
            const setBackground = (slide) => {
                let desktopUrl = slide.getAttribute('data-desktop');
                let mobileUrl = slide.getAttribute('data-mobile');
                let bgToUse = (isMobile && mobileUrl) ? mobileUrl : desktopUrl;
                if(bgToUse) slide.style.backgroundImage = bgToUse;
            };
            
            for(let i = 0; i < slides.length; i++) {
                setBackground(slides[i]);
            }
            
            if(slides.length > 0 && !slides[0].classList.contains('active')) {
                slides[0].classList.add('active');
            }
            
            if(slides.length > 1) {
                let current = 0;
                setInterval(() => {
                    slides[current].classList.remove('active');
                    current = (current + 1) % slides.length;
                    slides[current].classList.add('active');
                }, 7000);
            }
        }
        
        if(document.readyState === 'loading') {
            window.addEventListener('DOMContentLoaded', initSlides);
        } else {
            initSlides();
        }
    })();
    </script>
