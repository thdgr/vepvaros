    .vep-hero-title::after {
        content: attr(data-text); position: absolute; left: 0; top: 0;
        color: #fff; width: 0%; overflow: hidden; white-space: nowrap;
        border-right: 4px solid var(--vep-blue);
        animation: typeFill 2.5s cubic-bezier(0.7, 0, 0.3, 1) forwards 0.5s;
        -webkit-text-stroke: 0;
        padding-right: 5px;
    }
    @keyframes typeFill { 
        0% { width: 0%; opacity: 0.5; } 
        100% { width: 100%; opacity: 1; border-right-color: transparent; } 
    }

